# Servido pela Hostinger (Apache/LiteSpeed) na raiz do site.
# Fica em `public/` para o `next build` copiar para `out/` a cada build.

DirectoryIndex index.html

# Um endereco so: www.berexikrin.org.br vai para berexikrin.org.br
# (o mesmo de SITE.url em lib/site.ts). Sem isso o Google ve dois sites com o
# mesmo conteudo. O http -> https a Hostinger ja faz sozinha.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Enderecos do site antigo em WordPress (ate 2026). A exportacao estatica
  # do Next nao faz redirecionamento; e aqui que links antigos continuam
  # funcionando. Tabela completa em docs/mapa-do-site.md.
  RewriteRule ^quem-somos/?$ /sobre/ [R=301,L]
  RewriteRule ^plano-de-vida/?$ /sobre/#plano-de-vida [R=301,L,NE]
  RewriteRule ^nosso-territorio/?$ /territorio/ [R=301,L]
  RewriteRule ^(usina-belo-monte|pba-ci)/?$ /projetos/belo-monte/ [R=301,L]
  RewriteRule ^ci-brasil/?$ /projetos/restaura-amazonia/ [R=301,L]
  RewriteRule ^(casa-do-guerreiro|rituais-tradicionais|monitoramento-do-pescado)/?$ /projetos/$1/ [R=301,L]
  RewriteRule ^fundo-casa-socioambiental/?$ /projetos/internet-nas-aldeias/ [R=301,L]
  RewriteRule ^prefeitura-de-anapu/?$ /projetos/mudas-citricas/ [R=301,L]
  RewriteRule ^politica-de-privacidade/?$ /privacidade/ [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-json)(/.*)?$ / [R=301,L]
</IfModule>

# Cabecalhos de seguranca.
# - HSTS: o navegador passa a usar sempre https neste dominio (1 ano).
# - nosniff: o navegador nao "adivinha" o tipo de arquivo.
# - Frame: ninguem coloca o site dentro de um iframe de outro dominio.
# - CSP minima: so o que nao arrisca quebrar YouTube, fontes e formularios.
#   Uma CSP completa (script-src etc.) precisa ser testada no navegador antes.
<IfModule mod_headers.c>
  Header set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Pagina 404 do proprio Next (out/404.html), em vez da pagina padrao do servidor.
ErrorDocument 404 /404.html

# Os arquivos em /_next/static/ tem hash no nome: mudou o conteudo, mudou a URL.
# Por isso podem ser cacheados para sempre sem risco de servir versao velha.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|svg|png|jpg|jpeg|gif|webp|avif|mp4|webm)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # HTML nao: precisa revalidar para o visitante ver o deploy novo.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
