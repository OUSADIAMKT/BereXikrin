# Servido pela Hostinger (Apache/LiteSpeed) na raiz do site.
# Fica em `public/` para o `next build` copiar para `out/` a cada build.

DirectoryIndex index.html

# Um endereco so: www.berexikrin.org.br vai para berexikrin.org.br
# (o mesmo de SITE.url em lib/site.ts). Sem isso o Google ve dois sites com o
# mesmo conteudo. O http -> https a Hostinger ja faz sozinha.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # O Next pede os arquivos de pre-carregamento com pontos (__next.sobre.__PAGE__.txt),
  # mas a exportacao grava em subpastas (__next.sobre/__PAGE__.txt). Sem isto, cada
  # pagina gera erros 404 no console. O grupo (en) entra codificado (!KGVuKQ), por
  # isso as paginas em ingles tem 3 ou 4 niveis; o layout tem arquivo proprio.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.__PAGE__\.txt$ /$1__next.$2/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.__PAGE__\.txt$ /$1__next.$2/$3/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.([^./]+)\.__PAGE__\.txt$ /$1__next.$2/$3/$4/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.([^./]+)\.([^./]+)\.__PAGE__\.txt$ /$1__next.$2/$3/$4/$5/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.txt$ /$1__next.$2/$3.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.([^./]+)\.txt$ /$1__next.$2/$3/$4.txt [L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Enderecos do site antigo em WordPress (ate 2026). A exportacao estatica
  # do Next nao faz redirecionamento; e aqui que links antigos continuam
  # funcionando. Tabela completa em docs/mapa-do-site.md.
  RewriteRule ^quem-somos/?$ /sobre/ [R=301,L]
  RewriteRule ^plano-de-vida/?$ /sobre/#plano-de-vida [R=301,L,NE]
  RewriteRule ^nosso-territorio/?$ /territorio/ [R=301,L]
  RewriteRule ^(usina-belo-monte|pba-ci)/?$ /projetos/belo-monte/ [R=301,L]
  RewriteRule ^ci-brasil/?$ /projetos/restaura-amazonia/ [R=301,L]
  RewriteRule ^(casa-do-guerreiro|rituais-tradicionais|monitoramento-do-pescado)/?$ /projetos/$1/ [R=301,L]
  RewriteRule ^fundo-casa-socioambiental/?$ /projetos/internet-nas-aldeias/ [R=301,L]
  RewriteRule ^prefeitura-de-anapu/?$ /projetos/mudas-citricas/ [R=301,L]
  RewriteRule ^politica-de-privacidade/?$ /privacidade/ [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-json)(/.*)?$ / [R=301,L]
</IfModule>

# Cabecalhos de seguranca.
# - HSTS: o navegador passa a usar sempre https neste dominio (1 ano).
# - nosniff: o navegador nao "adivinha" o tipo de arquivo.
# - Frame: ninguem coloca o site dentro de um iframe de outro dominio.
# - CSP minima: so o que nao arrisca quebrar YouTube, fontes e formularios.
#   Uma CSP completa (script-src etc.) precisa ser testada no navegador antes.
<IfModule mod_headers.c>
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # CSP: so o proprio site carrega scripts, estilos, fontes e imagens. A unica
  # conexao externa e a newsletter (Google Apps Script); o unico iframe permitido e o video do YouTube (modo sem cookies) da pagina Apoie. 'unsafe-inline' e exigido
  # pelos scripts que o Next embute no HTML da exportacao estatica.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Pagina 404 do proprio Next (out/404.html), em vez da pagina padrao do servidor.
ErrorDocument 404 /404.html

# Os arquivos em /_next/static/ tem hash no nome: mudou o conteudo, mudou a URL.
# Por isso podem ser cacheados para sempre sem risco de servir versao velha.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|svg|png|jpg|jpeg|gif|webp|avif|mp4|webm)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # HTML nao: precisa revalidar para o visitante ver o deploy novo.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
